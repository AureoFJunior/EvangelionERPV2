WEB_IMAGE=evangelionerpv2-web
WORKER_ORDER_IMAGE=evangelionerpv2-worker-order
WORKER_EMAIL_IMAGE=evangelionerpv2-worker-email

# Caps the API container's memory. .NET reads this to size its GC heaps, so it is also what stops
# the process growing into all available RAM - and it makes local behaviour match the ECS task,
# where the same number is a hard OOM boundary.
WEB_MEM_LIMIT=2g
WEB_HOST_PORT=8080
NGINX_HOST_PORT=8082
ASPNETCORE_ENVIRONMENT=Development
CONTAINER_USER=0:0
APP_UID=0

SQLSERVER_HOST_PORT=14333
SQLSERVER_SA_PASSWORD=CHANGE_ME_STRONG_PASSWORD
EVA_CONN_STR=plain:Server=sqlserver,1433;Database=EvangelionERPV2;User Id=sa;Password=CHANGE_ME_STRONG_PASSWORD;TrustServerCertificate=True;Encrypt=False
EVA_REDIS_INSTANCE=evangelion/dev/redis-name:instancename
EVA_REDIS_CONNECTION=evangelion/dev/redis:ConnectionString
EVA_ENCRYPTION_KEY=evangelion/dev/encryptionkey:key
EVA_TOKEN_KEY=evangelion/dev/encryptiontokenkey:key
EVA_AWS_SECRET_NAME=AWSCredentials
EVA_AWS_PRODUCT_BUCKET=evangelionerpv2images
EVA_AWS_USER_BUCKET=evangelionerpv2images

# Agent. Off by default, the same posture as OpportunityRadar. Set true to run the assistant
# against an Ollama on the host (needs the ufw rule opening 11434 to the docker bridge).
EVA_AI_ENABLED=false

# Voice mode. Needs the `voice` compose profile, which runs a local Whisper beside the API.
# Audio is transcribed in flight and never stored.
EVA_AI_SPEECH_ENABLED=false

# The assistant's own voice, rendered by a local Piper on the same `voice` profile. One voice on
# every platform instead of whatever the machine has installed. The audio is streamed to the
# client and never written to disk or cached.
EVA_AI_VOICE_ENABLED=false

# COMPOSE_FILE names the compose files every command should include. There is only ever ONE of these
# lines in effect - the last one set wins - so pick the combination you want rather than uncommenting
# a second one further down. Whichever you choose, it applies only to commands that pass
# `--env-file .env.local`; compose reads `.env` by default, and an explicit `-f` overrides it
# entirely.
#
#   ...gpu.yml            Whisper on an NVIDIA card - large-v3 at ~0.45s against ~2.9s on CPU.
#                         Needs nvidia-container-toolkit; see "Whisper on the GPU" in the README.
#   ...observability.yml  Prometheus + Grafana. Requires GRAFANA_ADMIN_PASSWORD below, and naming
#                         the file is also what stops `down --remove-orphans` deleting them.
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.observability.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.observability.yml
EVA_AI_VOICE_NAME=pt_BR-faber-medium
EVA_ENABLE_INTERACTIVE_EMAIL_OAUTH=false
EVA_WORKER_SELF_API_AUTH=evangelion/dev/selfapilogin:log
EVA_RABBITMQ_HOSTNAME=evangelion/dev/rabbitmq-host:hostname
EVA_RABBITMQ_USERNAME=evangelion/dev/rabbitmq-user:username
EVA_RABBITMQ_PASSWORD=evangelion/dev/rabbitmq-pass:password
EVA_RABBITMQ_VHOST=evangelion/dev/rabbitmq-vhost:vhost
EVA_RABBITMQ_PORT=evangelion/dev/rabbitmq-port:port
EVA_RABBITMQ_URI=evangelion/dev/rabbitmq:uri

AWS_CREDENTIALS_DIR=C:/Users/<your-user>/.aws
AWS_PROFILE=default
AWS_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
AWS_SDK_LOAD_CONFIG=1

# Observability. Prometheus and Grafana live in docker-compose.observability.yml, which has to be
# named - either in COMPOSE_FILE above, with `-f`, or via local-up.ps1 -WithObservability. Grafana
# refuses to start without a password and there is no default, deliberately: a shipped default admin
# password on a dashboard that reads every tenant's numbers is the whole exposure in one line.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Prometheus binds to 127.0.0.1 only; it has no authentication of its own.
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
PROMETHEUS_RETENTION=30d
