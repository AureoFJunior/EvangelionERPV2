{
  "uid": "eva-api-overview",
  "title": "API overview",
  "description": "Rate, errors and duration for the API, plus the two facts that explain most incidents here: a dependency that is down, and a database that is behind the branch.",
  "tags": [
    "evangelion",
    "api"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pending migrations",
      "description": "Non-zero means requests touching the new tables answer 500 with 'Invalid column name'. Nothing applies migrations automatically - run scripts/local-db-update.sh.",
      "datasource": {
        "type": "prometheus",
        "uid": "evangelion-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 40
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evangelion-prometheus"
          },
          "expr": "max(evangelion_pending_migrations)",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Dependencies",
      "description": "1 healthy, 0.5 degraded, 0 unhealthy. Degraded is what the database check reports for pending migrations.",
      "datasource": {
        "type": "prometheus",
        "uid": "evangelion-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "0.5": {
                  "text": "Degraded",
                  "color": "orange",
                  "index": 1
                },
                "1": {
                  "text": "Healthy",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 24
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evangelion-prometheus"
          },
          "expr": "evangelion_health_check_status",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "legendFormat": "{{check}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API up",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "evangelion-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 24
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evangelion-prometheus"
          },
          "expr": "min(up{job=\"api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "evangelion-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 40
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evangelion-prometheus"
          },
          "expr": "time() - max(process_start_time_seconds{job=\"api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per second, by controller",
      "description": "From the recording rule, so this and the alert cannot disagree.",
      "datasource": {
        "type": "prometheus",
        "uid": "evangelion-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evangelion-prometheus"
          },
          "expr": "sum by (controller) (http_requests:rate5m)",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{controller}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Responses per second, by status",
      "description": "429 is the IP rate limiter doing its job, not a fault. It is charted separately from 5xx for that reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "evangelion-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evangelion-prometheus"
          },
          "expr": "sum by (code) (http_requests:rate5m)",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "5xx ratio",
      "description": "Alert fires above 2% for five minutes. 4xx is excluded: that is the caller's problem.",
      "datasource": {
        "type": "prometheus",
        "uid": "evangelion-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "max": 0.1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evangelion-prometheus"
          },
          "expr": "http_requests:error_ratio5m",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "5xx / all"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency",
      "description": "Buckets top out at 32.768s; anything slower lands in +Inf and the quantile becomes a lower bound.",
      "datasource": {
        "type": "prometheus",
        "uid": "evangelion-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evangelion-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "evangelion-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "evangelion-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Slowest controllers, p95",
      "description": "Per-controller rather than per-action: 184 actions is unreadable, and per-action detail is one click away in Explore.",
      "datasource": {
        "type": "prometheus",
        "uid": "evangelion-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evangelion-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (controller, le) (rate(http_request_duration_seconds_bucket[5m])))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{controller}}"
        }
      ]
    }
  ]
}
