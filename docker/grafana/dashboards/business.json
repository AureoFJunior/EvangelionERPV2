    {
      "id": 1,
      "type": "timeseries",
      "title": "Bill emails sent with no PDF",
      "description": "Nothing else sees this: the mail sends, the request answers 200, nothing retries.",
      "datasource": {
        "type": "prometheus",
        "uid": "evangelion-prometheus"
      },
      "pluginVersion": "12.0.0",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "barAlignment": 0,
            "lineWidth": 1,
            "fillOpacity": 8,
            "gradientMode": "none",
            "spanNulls": false,
