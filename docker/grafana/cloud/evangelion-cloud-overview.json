          "expr": "max(evangelion_pending_migrations)",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "pluginVersion": "12.0.0",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 1
