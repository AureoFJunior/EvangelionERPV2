# Production on the HostGator VPS. Copy to /opt/evangelion/.env (mode 0600, owner deploy) and fill
# every REPLACE_ value. Used with docker-compose.yml + docker-compose.prod.yml +
# docker-compose.hostgator.yml; scripts/vps-deploy.sh rewrites the four *_IMAGE lines per release.

# --- Images (ECR) ------------------------------------------------------------------------------
# The host pulls these through amazon-ecr-credential-helper (vps-bootstrap.sh configures it), so
# there is no docker login step. vps-deploy.sh replaces the tags with the release's sha- tags.
WEB_IMAGE=REPLACE_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/REPLACE_REPOSITORY:latest
WORKER_ORDER_IMAGE=REPLACE_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/REPLACE_REPOSITORY:worker-order-latest
WORKER_EMAIL_IMAGE=REPLACE_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/REPLACE_REPOSITORY:worker-email-latest
WORKER_NOTIFICATION_IMAGE=REPLACE_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/REPLACE_REPOSITORY:worker-notification-latest

# --- Edge -------------------------------------------------------------------------------------
CADDY_DOMAIN=REPLACE_WITH_PUBLIC_API_HOST
CADDY_EMAIL=REPLACE_WITH_LETSENCRYPT_CONTACT

ASPNETCORE_ENVIRONMENT=Production
CONTAINER_USER=1654:1654
APP_UID=1654

# --- Local services (only reachable on the Docker network) -------------------------------------
# Generate each with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# The SA password must have upper case, lower case and digits, or SQL Server refuses to start.
SQLSERVER_SA_PASSWORD=REPLACE
SQLSERVER_BACKUP_DIR=/opt/evangelion/backups
REDIS_PASSWORD=REPLACE
RABBITMQ_USER=evangelion
RABBITMQ_PASSWORD=REPLACE

# --- Secrets Manager references ----------------------------------------------------------------
# The host-specific ones live under evangelion/vps/ so the EC2 values stay untouched until the AWS
# teardown. Their contents (create them with scripts/vps-secrets.sh):
#   evangelion/vps/database       {"DefaultConnection": "Server=sqlserver,1433;Database=EvangelionERPV2;User Id=evangelion_app;Password=...;Encrypt=True;TrustServerCertificate=True"}
#   evangelion/vps/redis          {"ConnectionString": "redis:6379,password=<REDIS_PASSWORD>,abortConnect=false"}
#   evangelion/vps/rabbitmq       {"hostname": "rabbitmq", "username": "evangelion", "password": "<RABBITMQ_PASSWORD>",
#                                  "vhost": "/", "port": "5672", "uri": "amqp://evangelion:<RABBITMQ_PASSWORD>@rabbitmq:5672/"}
EVA_CONN_STR=evangelion/vps/database:DefaultConnection
EVA_REDIS_CONNECTION=evangelion/vps/redis:ConnectionString
EVA_RABBITMQ_HOSTNAME=evangelion/vps/rabbitmq:hostname
EVA_RABBITMQ_USERNAME=evangelion/vps/rabbitmq:username
EVA_RABBITMQ_PASSWORD=evangelion/vps/rabbitmq:password
EVA_RABBITMQ_VHOST=evangelion/vps/rabbitmq:vhost
EVA_RABBITMQ_PORT=evangelion/vps/rabbitmq:port
EVA_RABBITMQ_URI=evangelion/vps/rabbitmq:uri

# Not host-specific, so they keep the production values.
EVA_REDIS_INSTANCE=evangelion/prd/redis-name:instancename
EVA_ENCRYPTION_KEY=evangelion/prd/encryptionkey:key
EVA_TOKEN_KEY=evangelion/prd/encryptiontokenkey:key
EVA_WORKER_SELF_API_AUTH=evangelion/prd/selfapilogin:log
EVA_AWS_SECRET_NAME=AWSCredentials

# --- S3 -----------------------------------------------------------------------------------------
EVA_AWS_PRODUCT_BUCKET=REPLACE_WITH_PRIVATE_PRODUCT_BUCKET
EVA_AWS_USER_BUCKET=REPLACE_WITH_PRIVATE_USER_BUCKET
# Nightly SQL backups (scripts/vps-db-backup.sh). Created by terraform/vps-aws.
BACKUP_S3_URI=s3://REPLACE_WITH_BACKUP_BUCKET/sql

# --- Public URLs --------------------------------------------------------------------------------
EVA_DEFAULT_API_URL=http://evangelionerpv2:8080/api/v1
EVA_FRONTEND_BASE_URL=https://REPLACE_WITH_PUBLIC_APP_HOST
EVA_GOOGLE_REDIRECT_URI=https://REPLACE_WITH_PUBLIC_APP_HOST/auth/google/callback
EVA_RECAPTCHA_ALLOWED_HOSTNAME=REPLACE_WITH_PUBLIC_APP_HOST
EVA_CORS_ORIGIN=https://REPLACE_WITH_PUBLIC_APP_HOST
EVA_ALLOWED_HOSTS=REPLACE_WITH_PUBLIC_API_HOST
EVA_ENABLE_INTERACTIVE_EMAIL_OAUTH=false

# --- SMTP ---------------------------------------------------------------------------------------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# --- AWS access from outside AWS -----------------------------------------------------------------
# One IAM user (terraform/vps-aws) with read-only secrets, ECR pull and backup-bucket writes. Its
# key lives in .docker/aws/credentials under [evangelion]; never put it in this file.
AWS_CREDENTIALS_DIR=./.docker/aws
AWS_PROFILE=evangelion
AWS_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
AWS_SDK_LOAD_CONFIG=1
