root = true

[*.cs]

# ----------------------------------------------------------------------------------------------
# Fails the build. Every line here is a decision, and the list only ever grows.
#
# `TreatWarningsAsErrors` is deliberately not set: turning 62 projects red on day one gets the flag
# reverted, not the warnings fixed. These are the rules where a warning buried in a build log is
# the same as no warning at all.
# ----------------------------------------------------------------------------------------------

# Async correctness. This solution is async top to bottom and these are the bugs that reach
# production rather than the ones a reviewer sees.
dotnet_diagnostic.CS4014.severity = error      # fire-and-forget await
dotnet_diagnostic.CS1998.severity = error      # async method with no await
dotnet_diagnostic.CA2016.severity = error      # CancellationToken not forwarded

# Security. Zero occurrences today except the three noted at their call sites.
dotnet_diagnostic.S2068.severity = error       # hardcoded credentials
dotnet_diagnostic.S2077.severity = error       # SQL built by string formatting
dotnet_diagnostic.S3649.severity = error       # SQL built from user input
dotnet_diagnostic.S4830.severity = error       # certificate validation disabled
dotnet_diagnostic.S2259.severity = error       # null dereference

# ----------------------------------------------------------------------------------------------
# Downgraded, each with the count that earned it, measured 2026-09-24 over the whole solution.
# A rule is downgraded here once, in the open, instead of with a `#pragma` at every call site.
# ----------------------------------------------------------------------------------------------

# 178 sites. Passing the exception to the logger is right and it is a backlog, not a build break.
dotnet_diagnostic.S6667.severity = suggestion

# 163 sites, all of them `*DTO` against Sonar's preferred `*Dto`. This codebase spells it DTO in
# every namespace, folder and test; renaming the type set to satisfy a casing rule buys nothing.
dotnet_diagnostic.S101.severity = suggestion

# 154 sites. A redundant `!` is noise, not a defect, and the compiler's own nullable analysis is
# the thing actually guarding here.
dotnet_diagnostic.S8969.severity = suggestion

# 108 sites, most of them a catch that logs through a shared helper and rethrows.
dotnet_diagnostic.S2737.severity = suggestion

# 84 sites. Every persisted timestamp already goes through UTC helpers; the rule fires on literals
# and on values EF materialises.
dotnet_diagnostic.S6562.severity = suggestion

# Heavy in EF-facing code and noisy to fix in bulk. Kept visible in the IDE, out of the build log.
dotnet_diagnostic.CA1848.severity = suggestion

# Worth seeing, not worth failing on: this is a pt-BR application with pt-BR formatting.
dotnet_diagnostic.CA1305.severity = warning

[**/Migrations/*.cs]
generated_code = true
