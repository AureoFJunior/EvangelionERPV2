    "SpeechEnabled": false,
    "SpeechEndpoint": "http://localhost:9000",
    "SpeechModel": "small",
    "SpeechLanguage": "pt",
    "SpeechTimeoutSeconds": 30,
    "MaxAudioSeconds": 60,
    "MaxAudioBytes": 5242880,
    "SilenceMsToEndTurn": 1000
