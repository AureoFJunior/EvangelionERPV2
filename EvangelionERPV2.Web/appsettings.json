{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RequestLogging": {
    "EnableRequestBodyLogging": false
  },
  "RequestLimits": {
    "MaxRequestBodySizeBytes": 262144
  },
  "OpportunityRadarSettings": {
    "Enabled": false,
    "DefaultHistoryWindowDays": 180,
    "MinimumSampleOrders": 3
  },
  "AllowedHosts": "*"
}
