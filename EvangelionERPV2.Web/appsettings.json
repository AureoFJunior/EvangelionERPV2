{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RequestLogging": {
    "EnableRequestBodyLogging": false
  },
  "RequestLimits": {
    "MaxRequestBodySizeBytes": 262144
