        "ClientId": "evangelion/prd/googleclientid",
        "ClientSecret": "evangelion/prd/googleclientsecret"
    },
    "OpportunityRadarSettings": {
        "Enabled": false,
        "DefaultHistoryWindowDays": 180,
        "MinimumSampleOrders": 3
    },
    "Cors": {
        "AllowedOrigins": [
            "https://app.evangelionerp.com"
        ]
    },
    "AllowedHosts": "*",
    "IpRateLimiting": {
        "EnableEndpointRateLimiting": true,
        "StackBlockedRequests": false,
        "RealIpHeader": "X-Real-IP",
        "ClientIdHeader": "X-ClientId",
        "HttpStatusCode": 429,
        "GeneralRules": [
            {
                "Endpoint": "*",
                "Period": "1m",
                "Limit": 60
            },
            {
                "Endpoint": "*:/api/v1/User/LogInto",
                "Period": "1m",
                "Limit": 5
            },
            {
                "Endpoint": "*:/api/v1/User/LoginWithGoogle",
                "Period": "1m",
                "Limit": 5
            },
            {
                "Endpoint": "*:/api/v1/User/LoginWithGoogleCode",
                "Period": "1m",
                "Limit": 5
            }
        ]
    }
