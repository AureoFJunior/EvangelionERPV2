        "SecretName": "AWSCredentials",
        "BucketProducttName": "evangelionerpv2images",
        "BucketUserName": "evangelionerpv2images"
    },
    "RedisSettings": {
        "InstanceName": "evangelion/prd/redis-name:instancename",
