    },
    "EmailChannelSettings": {
        "QueueName": "emailQueue"
    },
    "EmailSettings": {
        "HostName": "",
        "Username": "",
        "Password": "",
        "Port": 0
    },
    "Encryption": {
        "Key": "evangelion/dev/encryptionkey:key"
    },
