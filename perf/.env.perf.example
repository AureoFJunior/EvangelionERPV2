# Copy to perf/.env.perf (git-ignored) and fill in. One account per access level, on the same
# enterprise, all four already seeded in the local database.
BASE_URL=http://localhost:8082/api/v1
# BASE_URL=http://localhost:5000/api/v1   # nginx bypass run, spec §7

ADMIN_USER=
ADMIN_PASS=
MANAGER_USER=
MANAGER_PASS=
SUPERVISOR_USER=
SUPERVISOR_PASS=
EMPLOYEE_USER=
EMPLOYEE_PASS=

# PDV only. X-Pdv-Terminal header form is "terminalId:credential", minted by Pdv/EnrollTerminal.
PDV_USER=
PDV_PASS=
PDV_TERMINAL=
# PDV_SESSION_ID=            # clientSessionId of an OPEN cash session, needed only with PERF_PDV_SYNC=1

# Opt-in write paths
# PERF_PRODUCT_UPDATE=1
# PERF_PDV_SYNC=1
