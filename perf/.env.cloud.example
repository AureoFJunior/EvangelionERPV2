# Grafana Cloud k6. Copy to perf/.env.cloud (git-ignored) and fill in.
#
#   cp perf/.env.cloud.example perf/.env.cloud
#
# Kept separate from .env.perf because seed.py rewrites that file from a fixed key list, so
# anything extra in it is silently lost on the next seed.

# Testing & synthetics -> Performance -> Settings -> Access -> Personal token.
# A stack token also works but additionally needs a projectID in the script's cloud options.
K6_CLOUD_TOKEN=

# The stack SLUG or URL, not a token. For https://acme.grafana.net this is: acme
K6_CLOUD_STACK=

# Leave unset for a local generator streaming results to the cloud. Set to 1 to generate from
# cloud addresses, which is the only way the 400-permit concurrency limiter gets exercised -
# and then BASE_URL must be publicly reachable, not localhost.
# K6_RUN_IN_CLOUD=1
# BASE_URL=https://app.evangelionerp.com/api/v1
